{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "compliq",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		// The Worker runs first for the API and for files that need a signed-in user.
		"run_worker_first": [
			"/api/*",
			"/reports/*",
			"/station_boxes.json",
			"/media/*"
		],
		// Same as Vercel's cleanUrls: /dashboard serves dashboard.html. Missing files return a real 404.
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "none"
	},
	"d1_databases": [
		// Paste the database_id printed by: npx wrangler d1 create compliq-db
		{
			"binding": "DB",
			"database_name": "compliq-db",
			"database_id": "ebb96a77-f490-43f6-8573-ca71124aeee0",
			"migrations_dir": "migrations"
		},
		{
			"binding": "CompliQ",
			"database_name": "compliq-db",
			"database_id": "ebb96a77-f490-43f6-8573-ca71124aeee0",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "compliq-files"
		},
		{
			"bucket_name": "compliq-files",
			"binding": "compliq_files",
			"remote": true
		}
	],
	"vars": {
		"SESSION_TTL_HOURS": "24",
		// Leave empty when the dashboard is served by this Worker (recommended). Comma-separated origins otherwise.
		"ALLOWED_ORIGINS": ""
	},
	"triggers": {
		"crons": [
			"17 21 * * *"
		]
	},
	"observability": {
		"enabled": true
	}
}
