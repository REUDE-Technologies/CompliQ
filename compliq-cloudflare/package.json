    "@noble/hashes": "1.8.0",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.154.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
